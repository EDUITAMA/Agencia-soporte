PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200
PRODUCT_NAME=Support Guard
PRODUCT_VERSION=0.1.0

# --- Support Guard ---
# REAL_JIRA uses the Jira variables below; MOCK_JIRA uses built-in demo cases (development only).
SUPPORT_GUARD_SOURCE=MOCK_JIRA
# DRY_RUN never modifies Jira. LIVE comments and returns cases for real.
JIRA_ACTIONS_MODE=DRY_RUN
SUPPORT_GUARD_AUTO_ENABLED=false
SUPPORT_GUARD_POLL_INTERVAL_SECONDS=300
SUPPORT_GUARD_REQUIRED_FIELDS=summary,description,priority,application,environment,reporter
# SUPPORT_GUARD_RULES_FILE=./support-guard.rules.json
# SUPPORT_GUARD_STATE_FILE=./data/support-guard-state.json

# Jira connection (same variable names as the reference Jira project). Set real values only in your local .env.
JIRA_URL=
# basic = Jira Cloud (email + API token); bearer = Jira Server/Data Center (personal access token)
JIRA_AUTH_MODE=bearer
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Optional JQL override; {JIRA_PROJECT_KEY} is substituted. Default is derived from JIRA_NEW_CASE_STATUSES.
# JIRA_JQL=
JIRA_NEW_CASE_STATUSES=Open
# Return transition: set the id OR the name of the transition that sends a case back for information.
# If neither is set, LIVE mode only comments and adds JIRA_PENDING_LABEL.
JIRA_RETURN_TRANSITION_ID=
JIRA_RETURN_TRANSITION_NAME=
JIRA_PENDING_LABEL=support-guard-pending-info
# Canonical field -> candidate Jira field ids, e.g. {"application":["customfield_10100"],"environment":["customfield_10101"]}
# JIRA_FIELD_MAP=

# Startup sync: sync once when the UI opens (skipped if data is fresher than the max age), then the scheduler takes over.
SUPPORT_GUARD_STARTUP_SYNC=true
SUPPORT_GUARD_STARTUP_SYNC_MAX_AGE_SECONDS=60

# --- AI analysis (local development only) ---
# AXET_BRIDGE_LOCAL: OpenAI-compatible local bridge (loopback URL only). MOCK_AI: deterministic fake for UI/tests.
SUPPORT_GUARD_AI_ENABLED=false
SUPPORT_GUARD_AI_PROVIDER=AXET_BRIDGE_LOCAL
SUPPORT_GUARD_AI_BASE_URL=http://127.0.0.1:4317/v1
SUPPORT_GUARD_AI_MODEL=gpt-5.6-terra
SUPPORT_GUARD_AI_TIMEOUT_MS=60000
SUPPORT_GUARD_AI_MAX_CONCURRENCY=2
SUPPORT_GUARD_AI_RETRY_SECONDS=120

# --- API authentication (aXet/Okta JWT) ---
# Set BOTH (https JWKS endpoint + issuer); a partial configuration aborts startup. Without them the API is open (local only)
# and LIVE mode is forced to DRY_RUN. Example: JWKS https://<okta-domain>/oauth2/<server>/v1/keys, issuer https://<okta-domain>/oauth2/<server>
SUPPORT_GUARD_AUTH_JWKS_URL=
SUPPORT_GUARD_AUTH_ISSUER=
# SUPPORT_GUARD_AUTH_AUDIENCE=
# Abort startup if auth is not configured. Defaults to true when NODE_ENV=production.
# SUPPORT_GUARD_REQUIRE_AUTH=true

# --- Support Intelligence (solo lectura) ---
INTELLIGENCE_ENABLED=true
INTELLIGENCE_DB_PATH=./data/support-guard.duckdb
# INTELLIGENCE_JQL=
# INTELLIGENCE_PERIOD_FIELD=created
INTELLIGENCE_PAGE_SIZE=100
INTELLIGENCE_MAX_CASES=5000
INTELLIGENCE_MAX_CUSTOM_DAYS=366
INTELLIGENCE_WARN_CUSTOM_DAYS=92
# INTELLIGENCE_EXCLUDED_ISSUE_TYPES=
# INTELLIGENCE_EXPECTED_SERVICES=
# INTELLIGENCE_NOISE_PATTERNS=
INTELLIGENCE_SIMILARITY_THRESHOLD=0.3
INTELLIGENCE_MIN_CLUSTER_SIZE=2
INTELLIGENCE_AI_ENABLED=true
INTELLIGENCE_AI_PROVIDER=AXET_BRIDGE_LOCAL
INTELLIGENCE_AI_BASE_URL=http://127.0.0.1:4317/v1
# INTELLIGENCE_AI_MODEL_LABEL=gpt-5.6-luna
# INTELLIGENCE_AI_MODEL_ANALYZE=gpt-5.6-terra
# INTELLIGENCE_AI_MODEL_VALIDATE=gpt-5.6-terra
# INTELLIGENCE_AI_MODEL_SUMMARY=gpt-5.6-terra
# Modelos por especialista del análisis profundo (por defecto, el modelo de razonamiento)
# INTELLIGENCE_AI_MODEL_FAILURE=gpt-5.6-terra
# INTELLIGENCE_AI_MODEL_FUNCTIONAL=gpt-5.6-terra
# INTELLIGENCE_AI_MODEL_TECHNICAL=gpt-5.6-terra
# INTELLIGENCE_AI_MODEL_INFRA=gpt-5.6-terra
# Reintentos acotados por especialista (default 1)
# INTELLIGENCE_AI_ROLE_RETRIES=1
INTELLIGENCE_AI_TIMEOUT_MS=60000
INTELLIGENCE_AI_MAX_CONCURRENCY=2
INTELLIGENCE_AI_MAX_CLUSTERS=15
INTELLIGENCE_AUTO_ANALYSIS_ENABLED=false
INTELLIGENCE_AUTO_ANALYSIS_PERIOD=WEEKLY
# SUMMARY o RECURRENCE. El análisis profundo nunca se ejecuta automáticamente.
# INTELLIGENCE_AUTO_ANALYSIS_MODE=RECURRENCE
# Fase 3 (inteligencia operativa): umbrales y narrativa ejecutiva (una sola llamada de IA por reporte)
# INTELLIGENCE_AI_MODEL_EXECUTIVE=gpt-5.6-terra
# INTELLIGENCE_AGING_BUCKETS_HOURS=24,72,168
# INTELLIGENCE_HISTORY_PERIODS=4
# INTELLIGENCE_OPS_CHANGE_THRESHOLD=0.15
# INTELLIGENCE_OPS_RECURRENCE_MEDIUM=0.25
# INTELLIGENCE_OPS_RECURRENCE_HIGH=0.5
# INTELLIGENCE_OPS_REOPENED_ELEVATED=0.08
# INTELLIGENCE_OPS_DQ_GOOD=70
# INTELLIGENCE_OPS_DQ_POOR=40
# INTELLIGENCE_OPS_PERSISTENT_PERIODS=2
INTELLIGENCE_AUTO_CHECK_MINUTES=60
